const icon = paths[name];
---

<svg
  class={className}
  viewBox={icon.viewBox}
  width="1em"
  height="1em"
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
  focusable="false"
>
  {
    icon.stroke ? (
      <path
        d={icon.d}
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    ) : (
      <path d={icon.d} fill="currentColor" />
    )
  }
</svg>
