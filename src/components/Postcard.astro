---
import type { Moment } from "../data/gallery";

interface Props {
  moment: Moment;
}

const { moment } = Astro.props;
const ratio = (moment.width / moment.height).toFixed(4);
---

<figure class="moment" style={`--ratio: ${ratio};`}>
  <div class="moment-photo">
    <img
      src={moment.src}
      alt={moment.alt}
      width={moment.width}
      height={moment.height}
      loading="lazy"
      decoding="async"
    />
    <span class="moment-tag glass">
      <span class="moment-code mono">{moment.countryCode}</span>
      <span>{moment.city}</span>
      <span class="moment-year mono">{moment.year}</span>
    </span>
  </div>
  <figcaption class="moment-caption">{moment.caption}</figcaption>
</figure>

<style>
  .moment {
    --h: clamp(300px, 34vw, 420px);
    width: min(calc(var(--h) * var(--ratio)), 86vw);
    margin: 0;
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .moment-photo {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    border-radius: 22px;
    background: var(--bg-alt);
    box-shadow:
      0 0 0 0.5px var(--line-soft),
      0 24px 40px -28px rgba(0, 0, 0, 0.45);
  }

  .moment-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }

  .moment:hover .moment-photo img {
    transform: scale(1.025);
  }

  .moment-tag {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.8rem 0.42rem 0.5rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  .moment-code {
    display: inline-grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.35rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--accent);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .moment-year {
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--muted);
  }

  .moment-caption {
    padding: 0 0.25rem;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.012em;
    color: var(--text);
  }
</style>
