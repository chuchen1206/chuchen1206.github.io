---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FieldLines from "../components/FieldLines.astro";
import CoverArt from "../components/CoverArt.astro";
import AlbumCard from "../components/AlbumCard.astro";
import Gallery from "../components/Gallery.astro";
import Postcard from "../components/Postcard.astro";
import Icons from "../components/Icons.astro";
import { profile } from "../data/profile";
import { publications, isFirstAuthor, byYearDesc } from "../data/publications";
import { service } from "../data/service";
import { moments } from "../data/gallery";

const paletteOf = Object.fromEntries(profile.researchThemes.map((t) => [t.key, t.palette]));
const isPublished = (p: (typeof publications)[number]) =>
  p.category === "journal" || p.category === "conference";

const selected = publications
  .filter(isPublished)
  .filter((p) => isFirstAuthor(p.authors))
  .sort(byYearDesc)
  .slice(0, 5);

const themePapers = (key: string) =>
  publications.filter((p) => p.theme === key && isPublished(p)).sort(byYearDesc).slice(0, 2);

const [inverse, imaging, geometry] = profile.researchThemes;

const spectrumAccents: Record<number, string> = { 9: "#75aadb", 21: "#f2c14e", 34: "#d9714e" };
const spectrum = Array.from({ length: 44 }, (_, i) => {
  const envelope = Math.exp(-Math.pow((i - 18) / 14, 2));
  const ripple = 0.55 + 0.45 * Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.45));
  return {
    h: Math.max(4, Math.round(60 * envelope * ripple)),
    color: spectrumAccents[i] ?? "#3a3a3c"
  };
});
const timeline = [
  ...profile.experience.map((e) => ({ ...e, kind: "Research" })),
  ...profile.education.map((e) => ({ ...e, kind: "Education" }))
];
const affiliationsDuring = (period: string) => profile.affiliations.filter((a) => a.period === period);

const serviceBlocks: { title: string; items: { text: string; href?: string }[] }[] = [
  {
    title: "Organizer",
    items: service.organizer.map((o) => ({ text: o.item, href: o.link }))
  },
  {
    title: "Reviewer",
    items: service.reviewer.map((text) => ({ text }))
  },
  {
    title: "Talks",
    items: service.talks.map((text) => ({ text }))
  },
  {
    title: "Teaching Assistant",
    items: service.teaching.map((text) => ({ text }))
  },
  {
    title: "Professional Service",
    items: service.professional.map((p) => ({ text: `${p.role}, ${p.org} (${p.period})` }))
  }
];

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  worksFor: { "@type": "Organization", name: profile.subtitle },
  email: `mailto:${profile.emails[0]}`,
  url: "https://chuchen1206.github.io",
  image: "https://chuchen1206.github.io/images/web/chu.jpg",
  knowsAbout: profile.researchInterests,
  sameAs: [profile.links.department, profile.links.orcid, profile.links.linkedin, profile.links.scholar, profile.links.github]
};
---

<BaseLayout
  title="Chu Chen | Academic Homepage"
  description="Chu Chen is a postdoctoral research fellow at the University of Cambridge working on inverse problems, scientific computing and medical imaging."
  canonical="https://chuchen1206.github.io/"
  page="home"
  jsonLd={personJsonLd}
>
  <link slot="head" rel="preload" as="image" href={profile.portrait} />

  <!-- Hero -->
  <section class="band hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="display" data-reveal>Chu Chen<span class="dot">.</span></h1>
        <div class="hero-position glass" data-reveal style="--reveal-delay: 80ms">
          <img class="hero-crest" src={profile.crest} alt="" width="139" height="160" />
          <div class="hero-position-text">
            <p class="hero-now">
              <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
              Now
            </p>
            <p class="hero-role">{profile.title}</p>
            <p class="hero-org">
              {profile.department}, <span class="nowrap">{profile.subtitle}</span>
            </p>
          </div>
        </div>
        <div class="hero-actions" data-reveal style="--reveal-delay: 160ms">
          <a class="btn btn--primary" href={`mailto:${profile.emails[0]}`}>
            <Icons name="mail" /> Get in touch
          </a>
          <a class="btn btn--glass" href={profile.links.scholar} target="_blank" rel="noopener noreferrer">
            <Icons name="scholar" /> Google Scholar
          </a>
        </div>
        <ul class="hero-links" data-reveal style="--reveal-delay: 240ms">
          <li>
            <a
              href={profile.links.department}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Department of Engineering profile"
              title="Department of Engineering profile"
            >
              <Icons name="university" />
            </a>
          </li>
          <li>
            <a href={profile.links.orcid} target="_blank" rel="noopener noreferrer" aria-label="ORCID">
              <Icons name="orcid" />
            </a>
          </li>
          <li>
            <a href={profile.links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <Icons name="github" />
            </a>
          </li>
          <li>
            <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <Icons name="linkedin" />
            </a>
          </li>
        </ul>
      </div>
      <figure class="hero-visual" data-reveal style="--reveal-delay: 120ms">
        <img
          class="hero-portrait"
          src={profile.portrait}
          alt={`Portrait of ${profile.name}`}
          width="750"
          height="1000"
          fetchpriority="high"
        />
        <figcaption class="hero-bio serif">{profile.bio}</figcaption>
      </figure>
    </div>
  </section>

  <!-- A1 Research -->
  <section id="research" class="band band--alt research">
    <FieldLines variant="court" class="research-lines" />
    <div class="wrap">
      <SectionHeader
        side="A1"
        eyebrow="Research"
        title="Seeing what measurements hide."
        lede="My work sits between applied mathematics and machine learning: models that are principled enough to trust, and efficient enough to use in real imaging systems."
      />

      <div class="bento">
        {
          [inverse, imaging, geometry].map((theme, i) => (
            <article
              class:list={["tile", "glass", `tile--${theme.key}`]}
              data-reveal
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <div class="tile-art">
                <CoverArt theme={theme.key} palette={theme.palette} seed={i + 3} />
              </div>
              <div class="tile-body">
                <h3 class="title">{theme.title}</h3>
                <p class="muted">{theme.description}</p>
                <ul class="tile-tags">
                  {theme.keywords.map((k) => (
                    <li class="pill">{k}</li>
                  ))}
                </ul>
                <ul class="tile-papers">
                  {themePapers(theme.key).map((p) => (
                    <li>
                      <a class="more" href={p.link} target="_blank" rel="noopener noreferrer">
                        {p.short ?? p.title} · {p.venueShort} {p.year}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
        <article class="tile tile--interests" data-reveal style="--reveal-delay: 270ms">
          <div class="interests-head">
            <p class="eyebrow">Interests</p>
            <svg class="spectrum" viewBox={`0 0 ${spectrum.length * 8} 64`} aria-hidden="true">
              {
                spectrum.map((bar, i) => (
                  <rect x={i * 8} y={64 - bar.h} width="4" height={bar.h} rx="1" fill={bar.color} />
                ))
              }
            </svg>
          </div>
          <ul class="interests">
            {profile.researchInterests.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- A2 Selected publications -->
  <section id="selected" class="band">
    <div class="wrap">
      <SectionHeader
        side="A2"
        eyebrow="Selected Publications"
        title="Selected works."
        lede="First-author papers from recent years. Hover a sleeve to pull the record out."
      >
        <a class="more" href="/publications">See all publications</a>
      </SectionHeader>
    </div>
    <Gallery label="Selected publications">
      {selected.map((pub, i) => <AlbumCard pub={pub} palette={paletteOf[pub.theme]} index={i} />)}
    </Gallery>
  </section>

  <!-- A3 Experience -->
  <section id="experience" class="band band--alt">
    <div class="wrap">
      <SectionHeader side="A3" eyebrow="Experience" />
      <ol class="timeline">
        {
          timeline.map((entry, i) => (
            <li class:list={["timeline-item", { current: i === 0 }]} data-reveal>
              <span class="timeline-period mono">{entry.period}</span>
              <span class="logo-tile glass">
                {entry.logo && <img src={entry.logo} alt={entry.logoAlt ?? ""} loading="lazy" />}
              </span>
              <div class="timeline-body">
                <p class="timeline-kind">{entry.kind}</p>
                <h3 class="title">{entry.role}</h3>
                <p class="timeline-inst">{entry.institution}</p>
                {entry.detail && <p class="muted">{entry.detail}</p>}
              </div>
              {affiliationsDuring(entry.period).map((a) => (
                <div class="affiliation">
                  <span class="logo-tile glass">
                    {a.logo && <img src={a.logo} alt={a.logoAlt ?? ""} loading="lazy" />}
                  </span>
                  <div class="timeline-body">
                    <p class="timeline-kind">Also affiliated with</p>
                    <h4 class="affiliation-name">{a.role}</h4>
                    {a.detail && <p class="muted">{a.detail}</p>}
                  </div>
                </div>
              ))}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- B1 Service -->
  <section id="service" class="band">
    <div class="wrap">
      <SectionHeader side="B1" eyebrow="Service & Talks" title="Community and teaching." />
      <div class="service-grid">
        {
          serviceBlocks.map((block, i) => (
            <div class="service-block glass" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
              <h3 class="service-title">{block.title}</h3>
              <ul>
                {block.items.map((item) =>
                  item.href ? (
                    <li>
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.text}
                      </a>
                    </li>
                  ) : (
                    <li>{item.text}</li>
                  )
                )}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- B2 Moments -->
  <section id="moments" class="band band--alt">
    <div class="wrap">
      <SectionHeader
        side="B2"
        eyebrow="Moments"
        title="On the road."
        lede="Conferences, visits and the people who make research a shared journey."
      />
    </div>
    <Gallery label="Moments">
      {moments.map((moment) => <Postcard moment={moment} />)}
    </Gallery>
  </section>

  <!-- Outro -->
  <section class="outro" aria-labelledby="contact-title">
    <div class="outro-bars" aria-hidden="true"><i></i><i></i><i></i></div>
    <svg class="outro-sea" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true">
      {
        [20, 46, 72, 98].map((y, i) => (
          <path
            d={`M${-i * 14} ${y} q20 -12 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0`}
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            opacity={0.55 - i * 0.1}
          />
        ))
      }
    </svg>
    <div class="wrap outro-inner">
      <p class="eyebrow outro-eyebrow">Contact</p>
      <h2 id="contact-title" class="outro-title" data-reveal>Let’s talk.</h2>
      <div class="outro-grid" data-reveal style="--reveal-delay: 120ms">
        <div>
          <p class="outro-label">Email</p>
          <a class="outro-email" href={`mailto:${profile.emails[0]}`}>{profile.emails[0]}</a>
        </div>
        <div>
          <p class="outro-label">Office</p>
          <p class="outro-address">{profile.location}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-top: calc(var(--nav-h) + clamp(3rem, 7vw, 5.5rem));
    padding-bottom: clamp(4rem, 9vw, 7rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 340px);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero-copy {
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }

  .hero-position {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.4rem);
    padding: clamp(1rem, 2vw, 1.35rem) clamp(1.25rem, 2.6vw, 1.9rem) clamp(1rem, 2vw, 1.35rem)
      clamp(1rem, 2vw, 1.35rem);
    border-radius: 26px;
    max-width: 100%;
  }

  .hero-crest {
    flex: none;
    width: clamp(48px, 5vw, 62px);
    height: auto;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.15));
  }

  .hero-position-text {
    display: grid;
    gap: 0.2rem;
  }

  .hero-now {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero-role {
    font-size: clamp(1.3rem, 2.4vw, 1.95rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .hero-org {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--muted);
    line-height: 1.3;
  }

  .nowrap {
    white-space: nowrap;
  }

  @media (min-width: 981px) {
    .hero-org {
      white-space: nowrap;
    }
  }

  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 1px;
    background: var(--accent);
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite;
  }

  .eq i:nth-child(2) {
    animation-delay: -0.4s;
    animation-duration: 0.9s;
  }

  .eq i:nth-child(3) {
    animation-delay: -0.7s;
    animation-duration: 1.3s;
  }

  @keyframes eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .dot {
    color: var(--accent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1.1rem;
  }

  .hero-links a {
    display: block;
    color: var(--muted);
    transition: color 200ms var(--ease);
  }

  .hero-links a:hover {
    color: var(--text);
  }

  .hero-links :global(svg) {
    width: 20px;
    height: 20px;
  }

  .hero-visual {
    width: 100%;
    margin: 0;
    justify-self: end;
    display: grid;
    gap: 1.1rem;
  }

  .hero-portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow:
      0 0 0 0.5px var(--line-soft),
      0 30px 60px -36px rgba(0, 0, 0, 0.45);
  }

  .hero-bio {
    font-style: italic;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.4;
    color: var(--text);
  }

  /* Research */
  .research-lines {
    opacity: 0.05;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.9rem, 1.6vw, 1.25rem);
  }

  .tile {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tile--inverse {
    grid-column: span 4;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
  }

  .tile--imaging {
    grid-column: span 2;
  }

  .tile--geometry {
    grid-column: span 2;
  }

  .tile--interests {
    grid-column: span 4;
    align-content: space-between;
    background: rgba(29, 29, 31, 0.9);
    color: #f5f5f7;
    box-shadow:
      inset 0 1px 0.5px rgba(255, 255, 255, 0.22),
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 16px 36px -18px rgba(0, 0, 0, 0.5);
  }

  .tile--interests .eyebrow {
    color: #a1a1a6;
  }

  .interests-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .spectrum {
    width: min(60%, 320px);
    height: auto;
  }

  .tile-art {
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--line-soft);
  }

  .tile--imaging .tile-art,
  .tile--geometry .tile-art {
    aspect-ratio: 16 / 10;
  }

  .tile-art :global(svg) {
    width: 100%;
    height: 100%;
  }

  .tile-body {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .tile-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tile-papers {
    display: grid;
    gap: 0.3rem;
    font-size: 0.92rem;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.1rem;
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .interests li:nth-child(3n + 1) {
    color: var(--sky);
  }

  .interests li:nth-child(3n + 2) {
    color: var(--lemon);
  }

  .interests li:nth-child(3n) {
    color: var(--terracotta);
  }

  /* Experience */
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
    margin-left: 0.35rem;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 11rem auto 1fr;
    align-items: start;
    gap: 0.4rem 1.5rem;
    padding: 0 0 2.5rem 2rem;
  }

  .logo-tile {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    padding: 10px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.86);
  }

  .logo-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: -6px;
    top: 0.3rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--faint);
  }

  .timeline-item.current::before {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .timeline-period {
    padding-top: 0.15rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .timeline-body {
    display: grid;
    gap: 0.3rem;
  }

  .timeline-kind {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .timeline-inst {
    font-size: 1.05rem;
  }

  .affiliation {
    grid-column: 2 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
    margin-top: 1.25rem;
  }

  .affiliation-name {
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  /* Service */
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.9rem, 1.6vw, 1.25rem);
  }

  .service-block {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: 1.5rem 1.6rem 1.75rem;
    border-radius: var(--radius-lg);
  }

  .service-title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .service-block ul {
    display: grid;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  /* Outro */
  .outro {
    --note-blue: #0b3a82;
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vw, 8rem) 0 clamp(8rem, 14vw, 12rem);
    background: var(--note-blue);
    color: #ffffff;
  }

  .outro-bars {
    position: absolute;
    top: clamp(3rem, 6vw, 4.5rem);
    right: 0;
    display: grid;
    gap: 8px;
    width: min(38vw, 420px);
  }

  .outro-bars i {
    display: block;
    height: 10px;
  }

  .outro-bars i:nth-child(1) {
    background: var(--lemon);
  }

  .outro-bars i:nth-child(2) {
    background: var(--terracotta);
    width: 82%;
    justify-self: end;
  }

  .outro-bars i:nth-child(3) {
    background: var(--sky);
    width: 64%;
    justify-self: end;
  }

  .outro-sea {
    position: absolute;
    right: 0;
    bottom: clamp(1.5rem, 4vw, 3rem);
    width: min(52vw, 640px);
    height: clamp(70px, 9vw, 120px);
    color: var(--sky);
  }

  .outro-inner {
    position: relative;
    display: grid;
    gap: 1.5rem;
  }

  .outro-eyebrow {
    color: rgba(255, 255, 255, 0.7);
  }

  .outro-title {
    font-size: clamp(4.5rem, 17vw, 15rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.85;
    margin-left: -0.06em;
    white-space: nowrap;
