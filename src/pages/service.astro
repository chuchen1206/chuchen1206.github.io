---
const target = "/#service";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Service | Chu Chen</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href="https://chuchen1206.github.io/#service" />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body>
    <p>Service has moved to <a href={target}>the homepage</a>.</p>
  </body>
</html>
